<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for Android 12 (API 31) and newer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Privacy: the filtered app/website database and the live-usage snapshot are kept on the
   device for both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="netgate_rules.db" />
        <exclude domain="database" path="netgate_rules.db-wal" />
        <exclude domain="database" path="netgate_rules.db-shm" />
        <exclude domain="sharedpref" path="netgate_live_usage_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="netgate_rules.db" />
        <exclude domain="database" path="netgate_rules.db-wal" />
        <exclude domain="database" path="netgate_rules.db-shm" />
        <exclude domain="sharedpref" path="netgate_live_usage_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
