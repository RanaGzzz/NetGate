<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices before Android 12 (API 31).
   See https://developer.android.com/guide/topics/data/autobackup

   Privacy: the filtered app/website database and the live-usage snapshot are kept on the
   device. Both are per-device state, and the database carries the user's app rules.
-->
<full-backup-content>
    <!-- Room database holding app rules, website rules and filter subscriptions. -->
    <exclude domain="database" path="netgate_rules.db" />
    <exclude domain="database" path="netgate_rules.db-wal" />
    <exclude domain="database" path="netgate_rules.db-shm" />
    <!-- Live per-app usage snapshot written by SystemNetworkMonitor. -->
    <exclude domain="sharedpref" path="netgate_live_usage_prefs.xml" />
</full-backup-content>
